# =============================================================
# MediBooking.in - Enterprise Production Environment Variables
# =============================================================

# Server Environment
NODE_ENV=production
PORT=4000
WEB_PORT=3000

# PostgreSQL Production Database (PgBouncer Transaction Pool)
DATABASE_URL=postgres://medibooking_user:YOUR_STRONG_POSTGRES_PASSWORD@postgres:5432/medibooking
POSTGRES_PASSWORD=YOUR_STRONG_POSTGRES_PASSWORD

# Redis Pub/Sub & Atomic Concurrency Engine
REDIS_URL=redis://:YOUR_STRONG_REDIS_PASSWORD@redis:6379
REDIS_PASSWORD=YOUR_STRONG_REDIS_PASSWORD

# JWT & Session Security
JWT_SECRET=YOUR_64_CHAR_CRYPTOGRAPHIC_JWT_SECRET
COOKIE_SECRET=YOUR_SECURE_COOKIE_SIGNING_SECRET

# Meta WhatsApp Business Cloud API (DLT Registered)
WHATSAPP_PHONE_NUMBER_ID=1376418502227507
WHATSAPP_BUSINESS_ACCOUNT_ID=1483246103715802
WHATSAPP_ACCESS_TOKEN=YOUR_META_PERMANENT_SYSTEM_USER_TOKEN
WHATSAPP_API_VERSION=v22.0

# Razorpay Payment Gateway (Flow A & B)
RAZORPAY_KEY_ID=rzp_live_YOUR_LIVE_KEY_ID
RAZORPAY_KEY_SECRET=YOUR_LIVE_KEY_SECRET
RAZORPAY_WEBHOOK_SECRET=YOUR_LIVE_WEBHOOK_SECRET

# Indian SMS Gateway (DLT Compliant)
SMS_GATEWAY_API_KEY=YOUR_DLT_SMS_API_KEY
SMS_SENDER_ID=MDBOKG

# Domain & Multi-Tenancy
BASE_DOMAIN=medibooking.in
NEXT_PUBLIC_APP_URL=https://medibooking.in
NEXT_PUBLIC_API_URL=https://medibooking.in/api

