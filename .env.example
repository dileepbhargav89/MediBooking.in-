# PostgreSQL Connection String (Supabase / Self-hosted)
DATABASE_URL="postgresql://postgres:[YOUR-PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres"
DIRECT_URL="postgresql://postgres:[YOUR-PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres"

# Supabase Project Configuration
NEXT_PUBLIC_SUPABASE_URL="https://[PROJECT-REF].supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="[YOUR-ANON-KEY]"
SUPABASE_PROJECT_REF="[PROJECT-REF]"

# Upstash Serverless Redis
UPSTASH_REDIS_REST_URL="https://[YOUR-ENDPOINT].upstash.io"
UPSTASH_REDIS_REST_TOKEN="[YOUR-REST-TOKEN]"
REDIS_URL="https://[YOUR-ENDPOINT].upstash.io"

# Meta WhatsApp Business Cloud API
WHATSAPP_ACCESS_TOKEN="[YOUR-META-WHATSAPP-TOKEN]"
WHATSAPP_PHONE_NUMBER_ID="[YOUR-PHONE-NUMBER-ID]"
WHATSAPP_BUSINESS_ACCOUNT_ID="[YOUR-WABA-ID]"
WHATSAPP_API_VERSION="v22.0"

# Razorpay Payment Gateway (Flow A: B2B Clinic SaaS Subscriptions)
RAZORPAY_KEY_ID="rzp_test_..."
RAZORPAY_KEY_SECRET="[YOUR-RAZORPAY-SECRET]"
NEXT_PUBLIC_RAZORPAY_KEY_ID="rzp_test_..."

# API Server Settings
PORT=4000
HOST="0.0.0.0"
NODE_ENV="development"
JWT_SECRET="generate-a-secure-random-32-character-secret"
CORS_ORIGIN="*"
